# Copy to .env.local and fill in. .env.local is gitignored.

# ── Supabase (required) ────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service role key (Settings → API). Required once RLS is enabled (migration
# 003): used ONLY server-side by /api/quick-save and by
# scripts/backfill-categories.mjs. It bypasses RLS — never expose it to the
# browser and never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── Site URL (optional) ────────────────────────────────────────────────────
# Public origin of the deployed app, e.g. https://linkvault.vercel.app. Used
# for absolute OG/metadata URLs. Defaults to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=

# ── AI categorization via Ollama (optional, runs locally) ──────────────────
# Where Ollama is reachable. Defaults to http://localhost:11434.
# For real-time tagging from a deployed app, point this at a tunnel
# (Cloudflare Tunnel / Tailscale) that exposes your local Ollama.
# Leave unset in production to skip real-time tagging and tag in batches
# later with `pnpm categorize` (see README).
OLLAMA_URL=http://localhost:11434
# Model used for categorization. Must be pulled: `ollama pull qwen3:8b`
OLLAMA_MODEL=qwen3:8b

# ── External quick-save endpoint (optional in dev, REQUIRED in prod) ────────
# Bearer token required by POST /api/quick-save. Used by the iOS Shortcut and
# the browser extension. If unset the endpoint is open in dev, but in
# production (NODE_ENV=production) it refuses all requests (503) until set.
QUICK_SAVE_API_KEY=generate-a-long-random-string
