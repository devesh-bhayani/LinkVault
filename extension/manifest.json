{
  "manifest_version": 3,
  "name": "Save to LinkVault",
  "version": "1.0.0",
  "description": "Right-click any link or page to save it straight to your LinkVault library.",
  "permissions": ["contextMenus", "storage", "activeTab"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Save to LinkVault"
  }
}
